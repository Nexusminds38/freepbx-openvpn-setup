# OpenVPN Client Configuration Template
# Replace placeholders with actual values

client
dev tun
proto udp

# Replace YOUR_SERVER_IP with your FreePBX server's public IP address
remote YOUR_SERVER_IP 1194

# Retry connecting to the server indefinitely
resolv-retry infinite

# Don't bind to a specific local port
nobind

# Downgrade privileges after initialization (Unix only)
user nobody
group nogroup

# Preserve state across restarts
persist-key
persist-tun

# Verify server certificate
remote-cert-tls server

# Enable compression (must match server setting)
comp-lzo

# Log verbosity level (0-9)
verb 3

# Silence repeating messages
mute 20

# Certificate Authority (CA) certificate
<ca>
-----BEGIN CERTIFICATE-----
# Paste your CA certificate here
-----END CERTIFICATE-----
</ca>

# Client certificate
<cert>
-----BEGIN CERTIFICATE-----
# Paste your client certificate here
-----END CERTIFICATE-----
</cert>

# Client private key
<key>
-----BEGIN PRIVATE KEY-----
# Paste your client private key here
-----END PRIVATE KEY-----
</key>
